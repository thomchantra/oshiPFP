{
  "id": "fumiko-c2",
  "algo": "pathF",
  "label": "Fumiko C2",
  "alias": "Fumiko Find Edge Off Overlay Passthrough Gradient Map C2",
  "lockedFields": ["findEdge", "saturation", "vividDeadzone", "vividBoost", "overlayPassthrough", "matteColor"],
  "params": {
    "sensitivity": 10,
    "radius": 0.2,
    "hardness": 0,
    "fillInvert": false,
    "findEdge": false,
    "saturation": 0.5,
    "vividDeadzone": 0.15,
    "vividBoost": 1.5,
    "opacity": 1,
    "blendMode": "multiply",
    "overlayPassthrough": true,
    "matteColor": [1, 1, 1],
    "fillType": "gradient",
    "tintColor": [0, 0, 0],
    "colorContrast": 1,
    "colorExposure": 0,
    "gradientShadow": [0, 0, 1],
    "gradientMid": [0, 1, 1],
    "gradientHighlight": [1, 1, 1],
    "gradientPivot": 0,
    "gradientDuoTone": false
  }
}
