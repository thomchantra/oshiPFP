{
  "id": "gumi-b2",
  "algo": "pathG",
  "label": "Gumi B2",
  "alias": "Gumi Line Mode Invert-Fill Add B2",
  "lockedFields": ["overlayPassthrough", "matteColor"],
  "params": {
    "threshold": 0.3,
    "blobMaxDt": 3,
    "gumiOverdrive": 0.3,
    "gumiLineInvert": true,
    "radius": 0,
    "gumiBlobGamma": 1,
    "opacity": 1,
    "blendMode": "add",
    "overlayPassthrough": false,
    "matteColor": [1, 1, 1],
    "gumiLineFillType": "solid",
    "gumiLineSolidColor": [0.196, 0.196, 1],
    "gumiLineColorContrast": 1,
    "gumiLineGradientPivot": 0,
    "gumiGradientShadow": [0, 0, 0],
    "gumiGradientMid": [0.5, 0.5, 0.5],
    "gumiGradientHighlight": [1, 1, 1]
  },
  "extraFields": [
    { "field": "gumiOverdrive", "label": "Line Overdrive", "min": 0, "max": 5, "step": 0.01 },
    { "field": "radius", "label": "Detection Radius", "min": 0, "max": 40, "step": 0.01 },
    { "field": "gumiBlobGamma", "label": "Detection Contrast", "min": 0.2, "max": 5, "step": 0.01 }
  ]
}
