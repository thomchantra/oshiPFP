{
  "id": "gumi-a1",
  "algo": "pathG",
  "label": "Gumi A1",
  "alias": "Gumi Line Mode A1",
  "lockedFields": ["overlayPassthrough", "matteColor"],
  "params": {
    "threshold": 0.3,
    "blobMaxDt": 3,
