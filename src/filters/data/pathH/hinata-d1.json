    "thresholdEnabled",
    "hiToneTarget",
    "overlayPassthrough",
    "matteColor",
    "responsiveCrossover",
    "responsiveGrow",
    "responsiveGrowBias",
    "edgeInvertFill",
    "edgeDuoTone",
